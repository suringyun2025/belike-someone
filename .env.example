# ---------------------------------------------------------------------------
# 本地开发环境变量。复制为 .env 后按需修改；不要把真实 .env 提交到 Git。
# 容器部署请改用 deploy/.env.example。
# ---------------------------------------------------------------------------

# development | production
DISTILL_ENV=development

# --- 存储（相对路径按当前工作目录解析）------------------------------------
DISTILL_DATA_DIR=./data
DISTILL_EXPORT_DIR=./exports
# 留空则使用 sqlite:///<data_dir>/app.db；PostgreSQL 示例：
# DISTILL_DATABASE_URL=postgresql+psycopg://user:pass@127.0.0.1:5432/distill
DISTILL_DATABASE_URL=

# --- 任务执行 ---------------------------------------------------------------
# 单机运行：API 进程内建 worker，与请求共享同一 SQLite 连接。
DISTILL_INLINE_WORKER=true
# 租约时长（秒），需明显大于单个阶段的最长耗时，否则任务会被其他 worker 接管。
DISTILL_WORKER_LEASE_SECONDS=300
# 空闲轮询间隔（秒）
DISTILL_WORKER_POLL_SECONDS=1

# --- 限制 -------------------------------------------------------------------
DISTILL_MAX_UPLOAD_MB=256
DISTILL_MAX_ZIP_ENTRIES=500
DISTILL_MAX_ZIP_UNCOMPRESSED_MB=1024
DISTILL_CHUNK_CHARS=800
DISTILL_CHUNK_OVERLAP=120
DISTILL_MAX_CHUNKS_PER_JOB=240

# --- 模型调用 ---------------------------------------------------------------
DISTILL_HTTP_TIMEOUT_SECONDS=90
DISTILL_LLM_MAX_RETRIES=3

# --- OCR / ASR（需 uv sync --project apps/api --extra ocr / --extra asr）---
DISTILL_WHISPER_MODEL=small
DISTILL_WHISPER_DEVICE=cpu

# --- 向量检索 ---------------------------------------------------------------
# auto：优先本地 ONNX 模型，失败回退哈希向量；fastembed：强制；hash：离线
DISTILL_EMBEDDING_BACKEND=auto
DISTILL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
DISTILL_EMBEDDING_DIM=512
DISTILL_EMBEDDING_MODEL_PATH=

# --- 日志 -------------------------------------------------------------------
DISTILL_LOG_LEVEL=INFO
# 设为 true 输出单行 JSON，便于容器日志采集
DISTILL_LOG_JSON=false