# ---------------------------------------------------------------------------
# 蒸馏平台 · 部署环境变量
#
# 复制为 deploy/.env 后修改。绝不能把真实的 deploy/.env 提交到 Git。
# ---------------------------------------------------------------------------

# --- 运行模式 ---------------------------------------------------------------
# production 会关闭 /docs 并启用严格默认值；development 便于本地排查。
DISTILL_ENV=production
# 日志：json 便于容器日志系统采集；text 便于人工阅读。
DISTILL_LOG_LEVEL=INFO
DISTILL_LOG_JSON=true

# --- 端口与监听 -------------------------------------------------------------
# 默认只绑定回环地址。局域网团队使用时改成 0.0.0.0，
# 但必须先确认已有反向代理或可信网络，否则同网段任何人都能上传资料。
DISTILL_BIND=127.0.0.1
DISTILL_PORT=8000

# --- 数据目录（容器内路径，对应 compose 的命名卷）---------------------------
DISTILL_DATA_DIR=/data
DISTILL_EXPORT_DIR=/exports

# --- 数据库 -----------------------------------------------------------------
# 留空则使用 SQLite（/data/app.db），适合单主机。
# PostgreSQL 模式由 compose.postgres.yaml 注入，不在此处配置。
# DISTILL_DATABASE_URL=postgresql+psycopg://user:pass@db:5432/distill

# --- 后台任务 ---------------------------------------------------------------
# 单机运行时为 true（API 进程内跑一个 worker）；
# compose 中 api 与 worker 分离，因此保持 false。
DISTILL_INLINE_WORKER=false
# 租约时长（秒）。必须明显大于单个阶段最长耗时，否则任务会被其他 worker 接管。
DISTILL_WORKER_LEASE_SECONDS=300

# --- 上传与解析上限 ---------------------------------------------------------
DISTILL_MAX_UPLOAD_MB=256
DISTILL_MAX_ZIP_ENTRIES=500
DISTILL_MAX_ZIP_UNCOMPRESSED_MB=1024
DISTILL_CHUNK_CHARS=800
DISTILL_CHUNK_OVERLAP=120
DISTILL_MAX_CHUNKS_PER_JOB=240

# --- 模型调用 ---------------------------------------------------------------
DISTILL_HTTP_TIMEOUT_SECONDS=90
DISTILL_LLM_MAX_RETRIES=3

# --- 向量检索 ---------------------------------------------------------------
# auto：优先本地 ONNX 模型，失败时回退到哈希向量；
# fastembed：强制使用模型（不可用则报错）；hash：强制离线。
DISTILL_EMBEDDING_BACKEND=auto
DISTILL_EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
DISTILL_EMBEDDING_DIM=512

# --- 可选能力 ---------------------------------------------------------------
# 构建时通过 --build-arg DISTILL_EXTRAS=ocr,asr 安装对应依赖。
DISTILL_WHISPER_MODEL=small
DISTILL_WHISPER_DEVICE=cpu

# --- CORS -------------------------------------------------------------------
# 前后端同源部署时无需修改；分离部署时填入前端域名（JSON 数组）。
# DISTILL_CORS_ORIGINS=["https://distill.example.com"]

# --- PostgreSQL 模式专用 ----------------------------------------------------
# POSTGRES_USER=distill
# POSTGRES_PASSWORD=change-me-before-deploying
# POSTGRES_DB=distill
# DISTILL_WORKER_REPLICAS=2